<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Deterministic>true</Deterministic>
    <!-- Core carries a native launcher. Preserve the consumer RID through
         intermediary project references instead of publishing a host helper. -->
    <IsRidAgnostic>false</IsRidAgnostic>
    <Version>7.2.1-linux-alpha</Version>
    <Authors>Git Extensions Team</Authors>
    <Company>Git Extensions</Company>
    <Product>Git Extensions</Product>
    <Copyright>Copyright © 2008-2026 Git Extensions Team</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Azreal42/gitextensions</RepositoryUrl>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
