<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <_BuildLinuxGitHelper Condition="$([MSBuild]::IsOSPlatform('Linux')) and ('$(RuntimeIdentifier)' == '' or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-')))">true</_BuildLinuxGitHelper>
    <_BuildMacGitSupervisor Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(RuntimeIdentifier)' == '' or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-')))">true</_BuildMacGitSupervisor>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_BuildMacGitSupervisor)' == 'true'">
    <_MacGitRuntime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_MacGitRuntime>
    <_MacGitRuntime Condition="'$(_MacGitRuntime)' == ''">$(NETCoreSdkRuntimeIdentifier)</_MacGitRuntime>
    <_MacGitArch Condition="'$(_MacGitRuntime)' == 'osx-x64'">x86_64</_MacGitArch>
    <_MacGitArch Condition="'$(_MacGitRuntime)' == 'osx-arm64'">arm64</_MacGitArch>
    <_MacGitDirectory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'native', '$(Configuration)', '$(_MacGitRuntime)'))</_MacGitDirectory>
    <_MacGitPath>$(_MacGitDirectory)/gitextensions-posix</_MacGitPath>
    <_MacGitBridge>$(_MacGitDirectory)/libgitextensions-posix.dylib</_MacGitBridge>
  </PropertyGroup>
  <ItemGroup Condition="'$(_BuildMacGitSupervisor)' == 'true'">
    <Content Include="$(_MacGitPath)" Link="gitextensions-posix" TargetPath="gitextensions-posix" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(_MacGitBridge)" Link="libgitextensions-posix.dylib" TargetPath="libgitextensions-posix.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildMacGitSupervisor" BeforeTargets="PrepareForBuild;AssignTargetPaths" Condition="'$(_BuildMacGitSupervisor)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(_MacGitArch)' == ''" Text="The private Mac supervisor requires osx-x64 or osx-arm64." />
    <MakeDir Directories="$(_MacGitDirectory)" />
    <Exec Command="cc -std=c11 -O2 -Wall -Wextra -Werror -arch $(_MacGitArch) -mmacosx-version-min=15.0 &quot;$(MSBuildProjectDirectory)/Native/gitextensions-posix.c&quot; -o &quot;$(_MacGitPath)&quot;" />
    <Exec Command="cc -std=c11 -O2 -Wall -Wextra -Werror -arch $(_MacGitArch) -mmacosx-version-min=15.0 -dynamiclib -Wl,-install_name,@rpath/libgitextensions-posix.dylib &quot;$(MSBuildProjectDirectory)/Native/gitextensions-posix-bridge.c&quot; -o &quot;$(_MacGitBridge)&quot;" />
    <ItemGroup><FileWrites Include="$(_MacGitPath);$(_MacGitBridge)" /></ItemGroup>
  </Target>
  <PropertyGroup Condition="'$(_BuildLinuxGitHelper)' == 'true'">
    <!-- Override GitProcessCompiler with an executable path for cross-RID builds. Never silently use a host binary. -->
    <GitProcessHelperRuntime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</GitProcessHelperRuntime>
    <GitProcessHelperRuntime Condition="'$(GitProcessHelperRuntime)' == ''">$(NETCoreSdkRuntimeIdentifier)</GitProcessHelperRuntime>
    <_GitProcessCrossCompile Condition="'$(GitProcessHelperRuntime)' != '$(NETCoreSdkRuntimeIdentifier)'">true</_GitProcessCrossCompile>
    <GitProcessCompiler Condition="'$(GitProcessCompiler)' == '' and '$(_GitProcessCrossCompile)' != 'true'">cc</GitProcessCompiler>
    <_GitProcessArch Condition="'$(GitProcessHelperRuntime)' == 'linux-x64'">GE_ARCH_X64</_GitProcessArch>
    <_GitProcessArch Condition="'$(GitProcessHelperRuntime)' == 'linux-arm64'">GE_ARCH_ARM64</_GitProcessArch>
    <_GitProcessHelperDirectory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'native', '$(Configuration)', '$(GitProcessHelperRuntime)'))</_GitProcessHelperDirectory>
    <GitProcessHelperDirectory>$([System.IO.Path]::GetFullPath('$(_GitProcessHelperDirectory)'))</GitProcessHelperDirectory>
    <GitProcessHelperPath>$(GitProcessHelperDirectory)/gitextensions-exec</GitProcessHelperPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(_BuildLinuxGitHelper)' == 'true'">
    <Content Include="$(GitProcessHelperPath)" Link="gitextensions-exec" TargetPath="gitextensions-exec"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Also build before content is requested transitively or when publishing skips the managed build. -->
  <Target Name="BuildGitProcessHelper" BeforeTargets="PrepareForBuild;AssignTargetPaths"
          Condition="'$(_BuildLinuxGitHelper)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(_GitProcessArch)' == ''" Text="The private Git process launcher supports linux-x64 and linux-arm64 only; unsupported RID $(GitProcessHelperRuntime)." />
    <Error Condition="'$(GitProcessCompiler)' == ''" Text="A cross-RID Git process launcher requires an explicit target compiler: -p:GitProcessCompiler=/absolute/path/to/compiler." />
    <MakeDir Directories="$(GitProcessHelperDirectory)" />
    <PropertyGroup>
      <_GitProcessCompileCommand>&quot;$(GitProcessCompiler)&quot; -std=c11 -O2 -Wall -Wextra -Werror -fPIE -pie -Wl,-z,relro,-z,now -D$(_GitProcessArch) &quot;$(MSBuildProjectDirectory)/Native/gitextensions-exec.c&quot; -o &quot;$(GitProcessHelperPath)&quot;</_GitProcessCompileCommand>
    </PropertyGroup>
    <WriteLinesToFile File="$(GitProcessHelperDirectory)/compiler-command.txt" Lines="$(_GitProcessCompileCommand)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Exec Command="$(_GitProcessCompileCommand)" />
    <ItemGroup>
      <FileWrites Include="$(GitProcessHelperPath);$(GitProcessHelperDirectory)/compiler-command.txt" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- Pure original GPG DTOs and shared Windows status classification; no WinForms/module controller dependency. -->
    <Compile Include="../../app/GitCommands/Git/Gpg/CommitStatus.cs" Link="Shared/Gpg/CommitStatus.cs" />
    <Compile Include="../../app/GitCommands/Git/Gpg/TagStatus.cs" Link="Shared/Gpg/TagStatus.cs" />
    <Compile Include="../../app/GitCommands/Git/Gpg/GpgInfo.cs" Link="Shared/Gpg/GpgInfo.cs" />
    <Compile Include="../../app/GitCommands/Git/Gpg/GpgSignatureStatusParser.cs" Link="Shared/Gpg/GpgSignatureStatusParser.cs" />
    <!-- Pure original credential identities; no Windows credential manager/UI dependency. -->
    <Compile Include="../../plugins/GitUIPluginInterfaces/BuildServerIntegration/BuildServerCredentialsType.cs" Link="Shared/BuildServerCredentialsType.cs" />
    <Compile Include="../../plugins/GitUIPluginInterfaces/BuildServerIntegration/IBuildServerCredentials.cs" Link="Shared/IBuildServerCredentials.cs" />
    <Compile Include="../../plugins/GitUIPluginInterfaces/BuildServerIntegration/BuildServerCredentials.cs" Link="Shared/BuildServerCredentials.cs" />
    <!-- Preserve the original completion value, matching, metadata and extraction rules. -->
    <Compile Include="../../app/GitUI/AutoCompletion/AutoCompleteWord.cs" Link="Shared/AutoCompleteWord.cs" />
    <Compile Include="../../app/GitUI/AutoCompletion/IAutoCompleteProvider.cs" Link="Shared/IAutoCompleteProvider.cs" />
    <Compile Include="../../app/GitUI/AutoCompletion/CommitMessageMetadataProvider.cs" Link="Shared/CommitMessageMetadataProvider.cs" />
    <Compile Include="../../app/GitUI/AutoCompletion/AutoCompleteRegexes.cs" Link="Shared/AutoCompleteRegexes.cs" />
    <!-- Preserve the Windows repository settings XML format without its cache/watchers. -->
    <Compile Include="../../app/GitCommands/XmlSerializableDictionary.cs" Link="Shared/XmlSerializableDictionary.cs" />
    <!-- Preserve the actual Windows revision link XML identities and URI equality. -->
    <Compile Include="../../app/GitCommands/ExternalLinks/ExternalLink.cs" Link="Shared/ExternalLink.cs" />
    <Compile Include="../../app/GitCommands/ExternalLinks/ExternalLinkDefinition.cs" Link="Shared/ExternalLinkDefinition.cs" />
    <!-- Keep the upstream pure identity and hosting parsers as the source of truth. -->
    <Compile Include="../../app/GitExtensions.Extensibility/Git/ObjectId.cs" Link="Shared/ObjectId.cs" />
    <Compile Include="../../app/GitExtensions.Extensibility/Git/DiffBranchStatus.cs" Link="Shared/DiffBranchStatus.cs" />
    <Compile Include="../../app/GitCommands/Remotes/RemoteParser.cs" Link="Shared/RemoteParser.cs" />
    <Compile Include="../../app/GitCommands/Remotes/GitHostingRemoteParser.cs" Link="Shared/GitHostingRemoteParser.cs" />
    <Compile Include="../../app/GitCommands/Remotes/GitHubRemoteParser.cs" Link="Shared/GitHubRemoteParser.cs" />
    <Compile Include="../../app/GitCommands/Remotes/AzureDevOpsRemoteParser.cs" Link="Shared/AzureDevOpsRemoteParser.cs" />
    <Compile Include="../../app/GitExtensions.Extensibility/Delimiters.cs" Link="Shared/Delimiters.cs" />
    <Compile Include="../../app/GitCommands/Utils/EncodingHelper.cs" Link="Shared/EncodingHelper.cs" />
    <Compile Include="../../app/GitCommands/Patches/PatchManager.cs" Link="Shared/PatchManager.cs" />
    <!-- Read-only patch preview uses the original metadata parser and DTO unchanged. -->
    <Compile Include="../../app/GitCommands/Patches/PatchProcessor.cs" Link="Shared/PatchProcessor.cs" />
    <Compile Include="../../app/GitExtensions.Extensibility/Git/Patch.cs" Link="Shared/Patch.cs" />
    <Compile Include="../../app/GitCommands/Git/GitBisectOption.cs" Link="Shared/GitBisectOption.cs" />
    <Compile Include="../../app/GitCommands/Git/CleanMode.cs" Link="Shared/CleanMode.cs" />
    <Compile Include="../../app/GitCommands/Git/Tag/TagOperation.cs" Link="Shared/TagOperation.cs" />
    <Compile Include="../../app/GitCommands/Git/CheckoutNewBranchMode.cs" Link="Shared/CheckoutNewBranchMode.cs" />
    <Compile Include="../../app/GitCommands/Git/AheadBehindData.cs" Link="Shared/AheadBehindData.cs" />
    <Compile Include="../../app/GitCommands/Settings/AppSettings.LocalChangesAction.cs" Link="Shared/LocalChangesAction.cs" />
    <Compile Include="../../app/GitCommands/Git/GitBranchNameNormaliser.cs" Link="Shared/GitBranchNameNormaliser.cs" />
    <Compile Include="../../app/GitCommands/Git/GitBranchNameOptions.cs" Link="Shared/GitBranchNameOptions.cs" />
    <Compile Include="../../app/GitCommands/Settings/IgnoreWhitespaceKind.cs" Link="Shared/IgnoreWhitespaceKind.cs" />
    <Compile Include="../../app/GitCommands/Settings/AutoCRLFType.cs" Link="Shared/AutoCRLFType.cs" />
    <Compile Include="../../app/GitCommands/Utils/AutoCrlfHelper.cs" Link="Shared/AutoCrlfHelper.cs" />
    <Compile Include="../../app/GitCommands/Settings/AppSettings.CommitInfoPosition.cs" Link="Shared/CommitInfoPosition.cs" />
  </ItemGroup>
</Project>
