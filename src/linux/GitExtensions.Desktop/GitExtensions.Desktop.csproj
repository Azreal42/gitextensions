<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>GitExtensions</AssemblyName>
    <ApplicationIcon>../../../setup/assets/Logo/git-extensions-logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the Windows contributor lists as raw XML; no ResX code generation or duplicated names. -->
    <EmbeddedResource Include="../../app/GitUI/Properties/Resources.resx" Link="Resources/Contributors.Windows.xml" LogicalName="GitExtensions.Contributors.Windows.xml" Type="Non-Resx" />
    <Content Condition="!$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) and ('$(RuntimeIdentifier)' != '' or !$([MSBuild]::IsOSPlatform('Windows')))" Include="gitextensions-askpass" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../GitExtensions.Core/GitExtensions.Core.csproj" />
    <ProjectReference Include="../GitExtensions.SpellChecking/GitExtensions.SpellChecking.csproj" />
    <ProjectReference Include="../GitExtensions.Plugins/GitExtensions.Plugins.csproj" />
    <ProjectReference Include="../GitExtensions.Avalonia.Skia.Patched/GitExtensions.Avalonia.Skia.Patched.csproj" GlobalPropertiesToRemove="Version;AssemblyVersion;FileVersion;InformationalVersion;PackageId;PackageVersion;SourceRevisionId;RepositoryCommit;Authors;Company;Product;Copyright;PackageLicenseExpression;RepositoryUrl" />
    <PackageVersion Include="Avalonia.Skia" Version="[11.3.22]" />
    <PackageReference Include="Avalonia.Skia" ExcludeAssets="compile;runtime" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaTerminal" />
    <PackageReference Include="Porta.Pty" />
    <PackageReference Include="SmartFormat" />
    <AvaloniaResource Include="../../app/GitUI/Resources/Icons/*.png" Link="Assets/Icons/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../app/GitUI/Resources/ChangeLog.md" Link="Assets/ChangeLog.md" />
    <AvaloniaResource Include="../../app/GitUI/Resources/Help/*.png" Link="Assets/Help/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../app/GitUI/CommandsDialogs/FormGitIgnore.resx;../../app/GitUI/CommandsDialogs/FormGitAttributes.resx;../../app/GitUI/CommandsDialogs/FormMailMap.resx" Link="Assets/RulesHelp/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../app/GitUI/Resources/Icons/difftastic.ico" Link="Assets/Icons/difftastic.ico" />
    <AvaloniaResource Include="../../app/GitUI/Resources/Backgrounds/DashboardBackground*.png" Link="Assets/Backgrounds/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../../setup/assets/Logo/GitExtensionsLogoWide.png" Link="Assets/GitExtensionsLogoWide.png" />
    <AvaloniaResource Include="../../../setup/assets/Logo/git-extensions-logo-16px.png" Link="Assets/Icons/git-extensions-logo-16px.png" />
    <AvaloniaResource Include="../../plugins/*/Resources/Icon*.png" Link="Assets/PluginIcons/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../plugins/Statistics/*/Resources/Icon*.png" Link="Assets/PluginIcons/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../app/GitUI/Themes/invariant.css" Link="Assets/Themes/invariant.css" />
    <AvaloniaResource Include="../../app/GitUI/Themes/dark.css" Link="Assets/Themes/dark.css" />
    <AvaloniaResource Include="../../../setup/assets/Logo/git-extensions-logo.ico" Link="Assets/git-extensions-logo.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reuse upstream pure tool command data; no Windows manager, registry or reflection discovery. -->
    <Compile Include="../../app/GitCommands/DiffMergeTools/DiffMergeTool.cs" Link="Shared/DiffMergeTools/DiffMergeTool.cs" />
    <Compile Include="../../app/GitCommands/DiffMergeTools/BeyondCompare4.cs" Link="Shared/DiffMergeTools/BeyondCompare4.cs" />
    <Compile Include="../../app/GitCommands/DiffMergeTools/DiffMerge.cs" Link="Shared/DiffMergeTools/DiffMerge.cs" />
    <Compile Include="../../app/GitCommands/DiffMergeTools/Kdiff3.cs" Link="Shared/DiffMergeTools/Kdiff3.cs" />
    <Compile Include="../../app/GitCommands/DiffMergeTools/Meld.cs" Link="Shared/DiffMergeTools/Meld.cs" />
    <Compile Include="../../app/GitCommands/DiffMergeTools/P4Merge.cs" Link="Shared/DiffMergeTools/P4Merge.cs" />
    <Compile Include="../../app/GitCommands/DiffMergeTools/Smerge.cs" Link="Shared/DiffMergeTools/Smerge.cs" />
    <Compile Include="../../app/GitCommands/DiffMergeTools/VsCode.cs" Link="Shared/DiffMergeTools/VsCode.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Keep the existing translation format and catalogues as the source of truth. -->
    <Compile Include="../../app/GitExtensions.Extensibility/Git/GitPullAction.cs" Link="Shared/GitPullAction.cs" />
    <Compile Include="../../app/GitCommands/Settings/AppSettings.TruncatePathMethod.cs" Link="Shared/Settings/AppSettings.TruncatePathMethod.cs" />
    <Compile Include="../../app/GitExtensions.Extensibility/Translations/ITranslation.cs" Link="Localization/Shared/ITranslation.cs" />
    <Compile Include="../../app/GitExtensions.Extensibility/Translations/Xliff/TranslationSerializer.cs" Link="Localization/Shared/TranslationSerializer.cs" />
    <Compile Include="../../app/GitExtensions.Extensibility/Translations/Xliff/TranslationFile.cs" Link="Localization/Shared/TranslationFile.cs" />
    <Compile Include="../../app/GitExtensions.Extensibility/Translations/Xliff/TranslationCategory.cs" Link="Localization/Shared/TranslationCategory.cs" />
    <Compile Include="../../app/GitExtensions.Extensibility/Translations/Xliff/TranslationBody.cs" Link="Localization/Shared/TranslationBody.cs" />
    <Compile Include="../../app/GitExtensions.Extensibility/Translations/Xliff/TranslationItem.cs" Link="Localization/Shared/TranslationItem.cs" />
    <Content Include="../../app/GitUI/Translation/*.gif" Link="Translation/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../app/GitUI/Translation/*.xlf" Link="Translation/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Share the Windows notification lock/coalescing contract without WinForms. -->
    <Compile Include="../../app/GitCommands/LockableNotifier.cs" Link="Shared/Notifications/LockableNotifier.cs" />
    <Compile Include="../../app/GitExtensions.Extensibility/ILockableNotifier.cs" Link="Shared/Notifications/ILockableNotifier.cs" />
    <!-- Pure upstream branch labels and word-boundary rules shared by Commit, spelling and Git completion. -->
    <Compile Include="../../app/GitCommands/Git/DetachedHeadParser.cs" Link="Shared/Git/DetachedHeadParser.cs" />
    <Compile Include="../../app/GitUI/CommandsDialogs/CommitDialog/WordWrapper.cs" Link="Shared/CommitDialog/WordWrapper.cs" />
    <Compile Include="../../app/GitUI/SpellChecker/WordAtCursorExtractor.cs" Link="Shared/SpellChecker/WordAtCursorExtractor.cs" />
    <Compile Include="../../app/GitUI/SpellChecker/SpellCheckerHelper.cs" Link="Shared/SpellChecker/SpellCheckerHelper.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pure Windows avatar settings and formatter; no WinForms/image provider code. -->
    <Compile Include="../../app/GitCommands/Settings/AvatarProvider.cs" Link="Shared/Avatars/AvatarProvider.cs" />
    <Compile Include="../../app/GitCommands/Settings/AvatarFallbackType.cs" Link="Shared/Avatars/AvatarFallbackType.cs" />
    <Compile Include="../../app/GitUI/Avatars/TemplateFormatter.cs" Link="Shared/Avatars/TemplateFormatter.cs" />
  </ItemGroup>
</Project>
