<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <_MacStartupDirectory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'native-startup'))</_MacStartupDirectory>
    <_MacStartupLibrary>$(_MacStartupDirectory)/native-startup-blocker.dylib</_MacStartupLibrary>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="$(_MacStartupLibrary)" Link="native-startup-blocker.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildMacStartupBlocker" BeforeTargets="PrepareForBuild;AssignTargetPaths"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(_MacStartupDirectory)" />
    <Exec Command="cc -std=c11 -O2 -Wall -Wextra -Werror -dynamiclib -mmacosx-version-min=15.0 &quot;$(MSBuildProjectDirectory)/NativeStartupBlocker.c&quot; -o &quot;$(_MacStartupLibrary)&quot;" />
    <ItemGroup><FileWrites Include="$(_MacStartupLibrary)" /></ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="../../../src/linux/GitExtensions.Core/GitExtensions.Core.csproj" />
    <ProjectReference Include="../GitExtensions.Core.Tests/GitExtensions.Core.Tests.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>
</Project>
